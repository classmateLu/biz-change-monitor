<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd 定时任务模板（每日运行）
  使用方法：
    1. 把 /Users/YOUR_USER 与 /path/to/biz-change-monitor 替换为实际路径
    2. 保存到 ~/Library/LaunchAgents/com.example.bizmonitor.plist
    3. launchctl load ~/Library/LaunchAgents/com.example.bizmonitor.plist
  Linux 用户请改用 cron 或 systemd timer（同一命令行）。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.bizmonitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USER/venv/bin/python3</string>
    <string>/path/to/biz-change-monitor/main.py</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/path/to/biz-change-monitor/logs/dailyrun.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/biz-change-monitor/logs/dailyrun.log</string>
</dict>
</plist>
